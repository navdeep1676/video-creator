FROM node:22-alpine

WORKDIR /app

# Install deps first (layer cache). Source is bind-mounted at runtime.
COPY package.json package-lock.json* ./
RUN npm install

# Source copied for first start; compose will mount live tree over this.
COPY . .

ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
