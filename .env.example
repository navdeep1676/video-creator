# Copy to .env for docker compose / local overrides
#
# TTS engines:
# - Edge free multi-language voices always available
# - Deepgram Aura 2 when DEEPGRAM_API_KEY is set (select "Deepgram Aura 2" in UI)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_CATALOG=live
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Naratto
# Gemini story models. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
# OpenAI story models. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
# Optional full path when ffmpeg is not on PATH. A winget FFmpeg install is found automatically.
FFMPEG_PATH=
FFPROBE_PATH=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_S=900
COMFYUI_POLL_S=2
# Qwen-Image-2.1 text-to-image graph. ComfyUI stays on 8188.
# Swap IMAGE_WORKFLOW and IMAGE_WORKFLOW_MAP together if you use a GGUF graph.
IMAGE_WORKFLOW=configs/workflows/qwen_image_2_1_t2i.json
IMAGE_WORKFLOW_MAP=configs/workflows/qwen_image_2_1_t2i.map.json
IMAGE_MODEL=qwen_image_2.1_int8_convrot.safetensors
IMAGE_CLIP=qwen3vl_8b_int8_convrot.safetensors
IMAGE_VAE=qwen_image_2.1_vae_bf16.safetensors
IMAGE_STEPS=25
IMAGE_CFG=1.0
IMAGE_MAX_SIDE=1024
WAN_BUDGET_RATIO=0.25
WAN_CLIP_MIN_SECONDS=5
WAN_CLIP_MAX_SECONDS=10

# ACE-Step 1.5 REST API. Keep this off port 8000 (that port is Naratto).
# Generate music starts the local server and stops it when the track is saved,
# so the process does not hold the GPU while you are doing something else.
# ACESTEP_MANAGE_PROCESS=false leaves a server you started yourself running.
# If the API runs in Docker and ACE-Step runs on the host:
#   ACESTEP_BASE_URL=http://host.docker.internal:8001
ACESTEP_BASE_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
MUSIC_MODEL=acestep-v15-turbo
ACESTEP_THINKING=false

DEEPGRAM_API_KEY=
# true = prefer free path when voice has Edge fallback; Aura-2 still uses Deepgram if key set
TTS_MOCK=true
SECRET_KEY=change-me-to-a-long-random-string

# Wan2.1 Image-to-Video (slide animation = "AI Motion")
# https://github.com/Wan-Video/Wan2.1
#
# REAL AI motion (recommended on Mac / Docker without GPU):
#   1. Get a key at https://fal.ai/models/fal-ai/wan-i2v  (or Replicate)
#   2. Set FAL_KEY=... below
#   3. Restart: docker compose ... up -d
#
# Mock zoom (NOT real AI — only a slow FFmpeg zoom):
#   WAN_I2V_MOCK=true
WAN_I2V_ENABLED=true
WAN_I2V_MOCK=false
# auto | fal | replicate | diffusers | cli | mock
WAN_I2V_BACKEND=auto
FAL_KEY=
# REPLICATE_API_TOKEN=
# REPLICATE_WAN_MODEL=wavespeedai/wan-2.1-i2v-480p
# Cloud I2V fallback only. Local renders do not load this 14B checkpoint.
WAN_I2V_MODEL_ID=Wan-AI/Wan2.1-I2V-14B-480P-Diffusers
WAN_I2V_RESOLUTION=480p
WAN_I2V_NUM_FRAMES=81
WAN_I2V_OFFLOAD=true
WAN_I2V_DEVICE=auto

# Wan2.2 TI2V 5B (AI Motion and text-to-video)
# Local only. ComfyUI is not used.
# https://huggingface.co/Wan-AI/Wan2.2-TI2V-5B
# The worker loads the Diffusers packaging of that model:
# https://huggingface.co/Wan-AI/Wan2.2-TI2V-5B-Diffusers
#
# Diffusers (default when a GPU PyTorch is installed):
#   pip install -r backend/requirements-wan.txt
#   First export downloads Wan-AI/Wan2.2-TI2V-5B-Diffusers
#
# Official script instead (the raw checkpoint from the link above):
#   WAN_T2V_BACKEND=cli
#   WAN_T2V_CKPT_DIR=/path/to/Wan2.2-TI2V-5B
#   WAN_T2V_CLI_SCRIPT=/path/to/Wan2.2/generate.py
#
# On an AMD GPU, install the ROCm PyTorch wheel. The app checks torch.cuda,
# which that wheel provides. Do not run this at the same time as ComfyUI or ACE-Step.
# 121 frames at 720p wants about 24 GB. The default 81 frames is for a 16 GB GPU.
WAN_T2V_ENABLED=true
WAN_T2V_MOCK=false
WAN_T2V_BACKEND=auto
WAN_T2V_MODEL_ID=Wan-AI/Wan2.2-TI2V-5B-Diffusers
WAN_T2V_WIDTH=1280
WAN_T2V_HEIGHT=704
WAN_T2V_NUM_FRAMES=81
WAN_T2V_GUIDANCE_SCALE=5
WAN_T2V_FLOW_SHIFT=5
WAN_T2V_NUM_INFERENCE_STEPS=50
WAN_T2V_OFFLOAD=true
WAN_T2V_DEVICE=auto
# Render-worker process env only (not this shared file): WAN_T2V_PRELOAD=true
# loads Wan2.2 TI2V 5B when that worker starts and keeps it until the render ends.
